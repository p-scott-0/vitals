<Window x:Class="Vitals.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitals Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Border x:Name="Root" Background="#BF0F1216" CornerRadius="8" Padding="12,6"
                BorderBrush="#40414B5F" BorderThickness="1">
            <StackPanel x:Name="Groups" Orientation="Horizontal"/>
        </Border>
        <!-- resize grip: visible only when the overlay is unlocked; drag to scale -->
        <Border x:Name="Grip" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#B322D3EE" CornerRadius="6,0,8,0" Cursor="SizeNWSE" Visibility="Collapsed"
                ToolTip="Drag to resize"/>
    </Grid>
</Window>
