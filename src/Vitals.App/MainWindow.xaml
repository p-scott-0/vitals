<Window x:Class="Vitals.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Vitals.App.Controls"
        Title="Vitals" Width="1240" Height="820" MinWidth="1000" MinHeight="680"
        Background="{StaticResource BgBrush}" WindowStyle="None"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        Closing="OnClosingWindow" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="16,0,8,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,1,9,0"/>
                <TextBlock Text="VITALS" Foreground="{StaticResource TextHiBrush}" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="SubtitleText" Text="system monitor" Foreground="{StaticResource TextLoBrush}" FontSize="12" Margin="10,1,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                <ToggleButton x:Name="OverlayBtn" Style="{StaticResource ChipToggle}" Content="Overlay" Click="OnOverlayBtn"/>
                <ToggleButton x:Name="SettingsBtn" Style="{StaticResource ChipToggle}" Content="Settings" Click="OnSettingsBtn" Margin="4,0,10,0"/>
                <Button Style="{StaticResource ChipButtonB}" Content="─" Click="OnMinimize" Padding="10,5"/>
                <Button x:Name="MaxBtn" Style="{StaticResource ChipButtonB}" Content="▢" Click="OnMaximize" Padding="10,5"/>
                <Button Style="{StaticResource ChipButtonB}" Content="✕" Click="OnCloseBtn" Padding="10,5"/>
            </StackPanel>
        </DockPanel>

        <!-- content -->
        <Grid Grid.Row="1" Margin="16,2,16,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="212"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- gauges -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="8">
                    <ctrl:ArcGauge x:Name="CpuGauge" Label="CPU"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="8">
                    <ctrl:ArcGauge x:Name="GpuGauge" Label="GPU"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="8">
                    <ctrl:ArcGauge x:Name="HotspotGauge" Label="GPU Hot Spot"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="8">
                    <ctrl:ArcGauge x:Name="VrmGauge" Label="VRM"/>
                </Border>
            </Grid>

            <!-- fans + system tiles -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="FANS" Style="{StaticResource CardTitle}"/>
                        <ItemsControl x:Name="FanItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="138" Margin="0,0,10,4" Background="#121620" CornerRadius="10"
                                            Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextLoBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,4">
                                                <TextBlock Text="{Binding Rpm}" FontSize="19" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextHiBrush}"/>
                                                <TextBlock Text="RPM" FontSize="9" Foreground="{StaticResource TextLoBrush}"
                                                           VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                                <TextBlock Text="{Binding PctText}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                            </StackPanel>
                                            <ctrl:BarMeter Value="{Binding Pct}" Height="5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="2,2,0,6">
                                <TextBlock x:Name="CpuLoadTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="CPU load" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="2,2,0,6">
                                <TextBlock x:Name="GpuLoadTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="GPU load" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="2,2,0,6">
                                <TextBlock x:Name="GpuPowerTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="GPU power" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="2,2,0,0">
                                <TextBlock x:Name="RamTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="RAM used" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="2,2,0,0">
                                <TextBlock x:Name="SysTempTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="system temp" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="2,2,0,0">
                                <TextBlock x:Name="SsdTileV" Text="--" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextHiBrush}"/>
                                <TextBlock Text="SSD temp" FontSize="10" Foreground="{StaticResource TextLoBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- charts: one row, three cards, so every chart gets full row height -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock x:Name="TempChartTitle" DockPanel.Dock="Top" Text="TEMPERATURES" Style="{StaticResource CardTitle}"/>
                        <ctrl:HistoryChart x:Name="TempChart" UnitSuffix="°"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock x:Name="FanChartTitle" DockPanel.Dock="Top" Text="FAN SPEEDS (RPM)" Style="{StaticResource CardTitle}"/>
                        <ctrl:HistoryChart x:Name="FanChart"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="FPS" Style="{StaticResource CardTitle}"/>
                        <ctrl:HistoryChart x:Name="FpsChart"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- status bar -->
        <DockPanel Grid.Row="2" Margin="18,0,18,6" LastChildFill="True">
            <TextBlock x:Name="StatusLeft" DockPanel.Dock="Left" FontSize="11" Foreground="{StaticResource TextLoBrush}"/>
            <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextLoBrush}"/>
            <TextBlock x:Name="StatusMid" FontSize="11" Foreground="{StaticResource TextLoBrush}" HorizontalAlignment="Center"/>
        </DockPanel>

        <!-- settings flyout -->
        <Border x:Name="SettingsFlyout" Grid.Row="1" HorizontalAlignment="Right" Width="410"
                Background="#F7161A22" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,0,1"
                CornerRadius="12,0,0,12" Padding="18,14" Margin="0,2,0,6" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="GENERAL" Style="{StaticResource CardTitle}"/>
                    <CheckBox x:Name="FpsCheck" Content="FPS capture (PresentMon)" Style="{StaticResource SettingCheck}"
                              Checked="OnFpsChanged" Unchecked="OnFpsChanged"/>
                    <CheckBox x:Name="FpsLogCheck" Content="Log FPS sessions to CSV" Style="{StaticResource SettingCheck}"
                              Checked="OnFpsLogChanged" Unchecked="OnFpsLogChanged"/>
                    <CheckBox x:Name="TrayCheck" Content="Close button hides to tray" Style="{StaticResource SettingCheck}"
                              Checked="OnTrayChanged" Unchecked="OnTrayChanged"/>
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Style="{StaticResource SettingCheck}"
                              Checked="OnStartupChanged" Unchecked="OnStartupChanged"/>
                    <CheckBox x:Name="StorageCheck" Content="SSD / HDD sensors (applies at next launch)" Style="{StaticResource SettingCheck}"
                              Checked="OnStorageChanged" Unchecked="OnStorageChanged"/>
                    <TextBlock Text="Sensor poll interval" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="PollChips" Orientation="Horizontal"/>

                    <TextBlock Text="DASHBOARD" Style="{StaticResource CardTitle}" Margin="2,18,0,8"/>
                    <TextBlock Text="Chart history window" Style="{StaticResource SettingLabel}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="ChartChips" Orientation="Horizontal"/>
                    <TextBlock Text="Fans — tick to show, type to rename" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="FanRows"/>

                    <TextBlock Text="GAMES" Style="{StaticResource CardTitle}" Margin="2,18,0,8"/>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource TextLoBrush}" TextWrapping="Wrap"
                               Text="A game is detected when its window is borderless or fullscreen, it lives in a game-library folder (Steam, Epic, GOG, Xbox, Ubisoft, EA…), or it holds 25+ FPS for two minutes — which adds it to this list for next time. Once detected, alt-tabbing changes nothing: FPS capture and playtime stay with the game until it exits. Sessions are logged to %APPDATA%\Vitals\logs\playtime.csv."/>
                    <TextBlock Text="Known games — click ✕ to forget one" Style="{StaticResource SettingLabel}"/>
                    <WrapPanel x:Name="KnownGamesPanel"/>
                    <DockPanel Margin="0,4,0,0" LastChildFill="False">
                        <TextBox x:Name="AddGameBox" Width="210" Style="{StaticResource SettingBox}"
                                 ToolTip="Process name, e.g. Sandustry or Sandustry.exe" KeyDown="OnAddGameKey"/>
                        <Button Content="Add" Style="{StaticResource ChipButtonB}" Click="OnAddGame" Margin="6,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="OVERLAY" Style="{StaticResource CardTitle}" Margin="2,18,0,8"/>
                    <CheckBox x:Name="OverlayCheck" Content="Overlay enabled" Style="{StaticResource SettingCheck}"
                              Checked="OnOverlayCheck" Unchecked="OnOverlayCheck"/>
                    <CheckBox x:Name="LockCheck" Content="Click-through (locked) — untick to drag it, or resize from its corner"
                              Style="{StaticResource SettingCheck}" Checked="OnLockChanged" Unchecked="OnLockChanged"/>
                    <TextBlock Text="Layout" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="LayoutChips" Orientation="Horizontal"/>
                    <TextBlock Text="Fan readout" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="FanModeChips" Orientation="Horizontal"/>
                    <TextBlock Text="Metrics" Style="{StaticResource SettingLabel}"/>
                    <WrapPanel x:Name="MetricChecks"/>
                    <TextBlock Text="Clock format" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="TimeChips" Orientation="Horizontal"/>
                    <TextBlock Text="Colours (hex, or click a swatch)" Style="{StaticResource SettingLabel}"/>
                    <StackPanel x:Name="ColourRows"/>
                    <TextBlock x:Name="BgOpacityLabel" Style="{StaticResource SettingLabel}"/>
                    <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="1" ValueChanged="OnOverlaySliders"/>
                    <TextBlock x:Name="OpacityLabel" Style="{StaticResource SettingLabel}"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" ValueChanged="OnOverlaySliders"/>
                    <TextBlock x:Name="ScaleLabel" Style="{StaticResource SettingLabel}"/>
                    <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="3" ValueChanged="OnOverlaySliders"/>
                    <Button Content="Reset overlay position" Style="{StaticResource ChipButtonB}" Click="OnResetOverlayPos"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>

                    <TextBlock FontSize="10.5" Foreground="{StaticResource TextLoBrush}" TextWrapping="Wrap" Margin="0,16,0,0"
                               Text="Fan curves stay in FanControl — Vitals only reads sensors. FPS logs land in %APPDATA%\Vitals\logs."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
